    "json-schema-to-typescript": "^15.0.2",
    "@gltf-transform/cli": "^4.1.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/cli": "^4.0.0",
    "basecoat-css": "^0.3.0",
    "lucide-static": "^0.460.0"
  }
}
