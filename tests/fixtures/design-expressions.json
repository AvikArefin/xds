{
  "_doc": [
    "Shared cases for the design expression language (docs/lighting-and-backgrounds.md §3.3).",
    "Both xds/designs.py (tests/test_designs.py) and apps/studio/src/design/resolve.ts run every case and must agree.",
    "Each case: `expr` is the text between {{ and }}; `ok` says whether it is accepted (parses AND every name is known);",
    "`names` (optional) adds variables to the scope for that case only, e.g. loop variables {\"i\": 2, \"n\": 5};",
    "`value` (optional, only when ok) is the result of evaluating it in `context` + `names`; numbers compare with tolerance 1e-9,",
    "strings and booleans exactly. `error` (only when not ok) is `syntax` (does not parse, an unsupported construct, an unknown",
    "function or a wrong argument count; Python code DESIGN_BAD_EXPRESSION) or `name` (valid syntax that reads an unknown variable;",
    "Python code DESIGN_UNKNOWN_PARAM).",
    "Known names: width, height, subject.{x,y,w,h,cx,cy,floor}, brand.<token>, and the params below (all from `context`).",
    "Grammar: numbers (plain decimals, no exponent/hex), strings in '…' or \"…\", dotted names, + - * / %, unary - +, parentheses,",
    "one comparison (== != < <= > >=, not chained), calls of the listed functions only. No and/or/not, ^, **, ?:, [], or member access on non-names.",
    "Semantics follow JavaScript: % is the remainder (-7 % 3 = -1), round() rounds half up (round(2.5) = 3, round(-2.5) = -2),",
    "comparisons give booleans, cond(test, a, b) picks a when test is truthy. Color param values are hex here (token names are",
    "resolved to hex before evaluation). Color functions work in OKLCH (mix in OKLab), gamut-map by reducing chroma and format as",
    "lowercase #rrggbb, or #rrggbbaa when alpha < 1; only alpha() results are pinned here because they need no color conversion."
  ],
  "context": {
    "width": 1080,
    "height": 1350,
    "subject": { "x": 340, "y": 400, "w": 400, "h": 600, "cx": 540, "cy": 700, "floor": 1000 },
    "brand": { "paper": "#f2f1ee", "ink": "#1a1a1a", "accent": "#ff5a1f" },
    "params": { "glow": 0.5, "wall": "#e8e4dc", "vignette": true, "mode": "soft", "count": 3 }
  },
  "cases": [
    { "expr": "42", "ok": true, "value": 42 },
    { "expr": "3.25", "ok": true, "value": 3.25 },
    { "expr": "width", "ok": true, "value": 1080 },
    { "expr": " width / 2 ", "ok": true, "value": 540 },
    { "expr": "1 + 2 * 3", "ok": true, "value": 7 },
    { "expr": "(1 + 2) * 3", "ok": true, "value": 9 },
    { "expr": "10 - 4 - 3", "ok": true, "value": 3 },
    { "expr": "-subject.cx + 40", "ok": true, "value": -500 },
    { "expr": "+5", "ok": true, "value": 5 },
    { "expr": "7 % 3", "ok": true, "value": 1 },
    { "expr": "-7 % 3", "ok": true, "value": -1 },
    { "expr": "subject.floor / height", "ok": true, "value": 0.7407407407407407 },
    { "expr": "subject.cy - subject.h / 2", "ok": true, "value": 400 },
    { "expr": "subject.x + subject.w", "ok": true, "value": 740 },
    { "expr": "width * glow", "ok": true, "value": 540 },
    { "expr": "min(3, 1, 2)", "ok": true, "value": 1 },
    { "expr": "max(subject.w, subject.h)", "ok": true, "value": 600 },
    { "expr": "clamp(1.4, 0, 1)", "ok": true, "value": 1 },
    { "expr": "clamp(-2, 0, 1)", "ok": true, "value": 0 },
    { "expr": "round(2.5)", "ok": true, "value": 3 },
    { "expr": "round(-2.5)", "ok": true, "value": -2 },
    { "expr": "round(2.4)", "ok": true, "value": 2 },
    { "expr": "floor(2.7) + ceil(2.1)", "ok": true, "value": 5 },
    { "expr": "abs(-3)", "ok": true, "value": 3 },
    { "expr": "sqrt(16)", "ok": true, "value": 4 },
    { "expr": "pow(2, 10)", "ok": true, "value": 1024 },
    { "expr": "sin(0) + cos(0)", "ok": true, "value": 1 },
    { "expr": "lerp(10, 20, 0.25)", "ok": true, "value": 12.5 },
    { "expr": "lerp(0, width, i / n)", "names": { "i": 2, "n": 4 }, "ok": true, "value": 540 },
    { "expr": "width * (0.5 + 0.4 * cos(i * 2))", "names": { "i": 0, "n": 3 }, "ok": true, "value": 972 },
    { "expr": "width > height", "ok": true, "value": false },
    { "expr": "width < height", "ok": true, "value": true },
    { "expr": "width <= 1080", "ok": true, "value": true },
    { "expr": "height >= 1351", "ok": true, "value": false },
    { "expr": "glow == 0.5", "ok": true, "value": true },
    { "expr": "glow != 0.5", "ok": true, "value": false },
    { "expr": "mode == 'soft'", "ok": true, "value": true },
    { "expr": "cond(vignette, 1, 0)", "ok": true, "value": 1 },
    { "expr": "cond(width > height, 'landscape', 'portrait')", "ok": true, "value": "portrait" },
    { "expr": "cond(i % 2 == 0, 10, 20)", "names": { "i": 3, "n": 4 }, "ok": true, "value": 20 },
    { "expr": "'#1a1a1a'", "ok": true, "value": "#1a1a1a" },
    { "expr": "\"#ffffff\"", "ok": true, "value": "#ffffff" },
    { "expr": "brand.paper", "ok": true, "value": "#f2f1ee" },
    { "expr": "wall", "ok": true, "value": "#e8e4dc" },
    { "expr": "alpha('#ff0000', 0.5)", "ok": true, "value": "#ff000080" },
    { "expr": "alpha(brand.ink, 0)", "ok": true, "value": "#1a1a1a00" },
    { "expr": "alpha(brand.ink, 1)", "ok": true, "value": "#1a1a1a" },
    { "expr": "tone(wall, 0.94, 0.03)", "ok": true },
    { "expr": "tone(brand.accent, 0.18)", "ok": true },
    { "expr": "shade(wall, -0.06)", "ok": true },
    { "expr": "mix(brand.paper, brand.ink, glow)", "ok": true },
    { "expr": "hue(brand.accent, 40)", "ok": true },
    { "expr": "alpha(shade(tone(wall, 0.3), 0.1), glow * 0.5)", "ok": true },
    { "expr": "count", "ok": true, "value": 3 },

    { "expr": "", "ok": false, "error": "syntax" },
    { "expr": "   ", "ok": false, "error": "syntax" },
    { "expr": "1 +", "ok": false, "error": "syntax" },
    { "expr": "(1 + 2", "ok": false, "error": "syntax" },
    { "expr": "1 + 2)", "ok": false, "error": "syntax" },
    { "expr": "1 2", "ok": false, "error": "syntax" },
    { "expr": "width height", "ok": false, "error": "syntax" },
    { "expr": "2 ** 3", "ok": false, "error": "syntax" },
    { "expr": "2 ^ 3", "ok": false, "error": "syntax" },
    { "expr": "7 // 2", "ok": false, "error": "syntax" },
    { "expr": "width > 1 ? 1 : 0", "ok": false, "error": "syntax" },
    { "expr": "1 if vignette else 0", "ok": false, "error": "syntax" },
    { "expr": "vignette and true", "ok": false, "error": "syntax" },
    { "expr": "vignette or glow", "ok": false, "error": "syntax" },
    { "expr": "not vignette", "ok": false, "error": "syntax" },
    { "expr": "0 < glow < 1", "ok": false, "error": "syntax" },
    { "expr": "1e3", "ok": false, "error": "syntax" },
    { "expr": "0x10", "ok": false, "error": "syntax" },
    { "expr": "[1, 2]", "ok": false, "error": "syntax" },
    { "expr": "subject['cx']", "ok": false, "error": "syntax" },
    { "expr": "min(1, 2).x", "ok": false, "error": "syntax" },
    { "expr": "width = 3", "ok": false, "error": "syntax" },
    { "expr": "'a' 'b'", "ok": false, "error": "syntax" },
    { "expr": "{{width}}", "ok": false, "error": "syntax" },
    { "expr": "clamp(1, 2)", "ok": false, "error": "syntax" },
    { "expr": "lerp(1, 2, 3, 4)", "ok": false, "error": "syntax" },
    { "expr": "tone(wall)", "ok": false, "error": "syntax" },
    { "expr": "cond(vignette, 1)", "ok": false, "error": "syntax" },
    { "expr": "random()", "ok": false, "error": "syntax" },
    { "expr": "Math.max(1, 2)", "ok": false, "error": "syntax" },
    { "expr": "exp(1)", "ok": false, "error": "syntax" },

    { "expr": "depth", "ok": false, "error": "name" },
    { "expr": "width * depth", "ok": false, "error": "name" },
    { "expr": "subject.z", "ok": false, "error": "name" },
    { "expr": "subject", "ok": false, "error": "name" },
    { "expr": "brand.primary", "ok": false, "error": "name" },
    { "expr": "brand", "ok": false, "error": "name" },
    { "expr": "i * 10", "ok": false, "error": "name" },
    { "expr": "n", "ok": false, "error": "name" },
    { "expr": "true", "ok": false, "error": "name" },
    { "expr": "PI * 2", "ok": false, "error": "name" },
    { "expr": "cond(flag, 1, 0)", "ok": false, "error": "name" },
    { "expr": "tone(brand.wall, 0.5)", "ok": false, "error": "name" }
  ]
}
